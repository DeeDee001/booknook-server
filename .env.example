# Server Configuration
PORT=5000

# MongoDB Connection String (Replace with your actual MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/booknook?retryWrites=true&w=majority

# JWT Secret for token verification
JWT_SECRET=booknook_jwt_secret_key_change_me_in_production

# Frontend Application URL (for CORS)
CLIENT_URL=http://localhost:3000
